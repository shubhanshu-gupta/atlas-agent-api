# Server
PORT=8080

# Payments (Phase 3) — keep false until the free API contract is verified
PAYMENTS_ENABLED=false

# Receive-only EVM address for USDC settlement. Generate fresh; never a personal
# hot-wallet key. No private key is ever needed by this service.
SELLER_ADDRESS=0x0000000000000000000000000000000000000000

# Price per profile call in USDC
PRICE_PER_PROFILE=$0.001

# "testnet" or "mainnet". Controls which Gateway facilitator URL is used.
# Defaults to testnet even if unset — never flips to mainnet implicitly.
# Only set to "mainnet" during the Phase 5 mainnet cutover.
GATEWAY_NETWORK_ENV=testnet
